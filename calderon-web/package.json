    "@tanstack/react-query-devtools": "^5.104.2",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
