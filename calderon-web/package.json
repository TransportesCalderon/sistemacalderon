{
  "name": "calderon-web",
  "version": "0.1.0",
  "private": true,
  "description": "Transportes Calderón — ERP de flota, combustible y anomalías (frontend Next.js 15)",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
