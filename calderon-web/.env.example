# Copiar como .env.local y completar con los datos de Project Settings → API (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Solo scripts y jobs. NUNCA en el navegador ni en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Para `npm run gen:types`
SUPABASE_PROJECT_ID=<project-ref>

# Zona horaria por defecto para mostrar fechas (se guardan en UTC)
NEXT_PUBLIC_ZONA_HORARIA_DEFECTO=America/Argentina/Mendoza
